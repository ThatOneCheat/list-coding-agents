# Everything text is stored and checked out with LF so the build is
# byte-identical on every OS (the CI drift check depends on it).
* text=auto eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.ps1xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.woff2 binary
*.png binary
*.ttf binary
